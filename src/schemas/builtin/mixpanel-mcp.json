              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "Run-Query",
                      "Get-Query-Schema",
                      "Get-Report",
                      "Display-Query",
                      "Get-User-Replays-Data",
                      "List-Dashboards",
                      "Get-Dashboard",
                      "Get-Projects",
                      "List-Organizations",
                      "Get-Business-Context",
                      "Search-Entities",
                      "Get-Audit-Log",
                      "Get-Events",
                      "List-Properties",
                      "Get-Property-Values",
                      "Get-Issues",
                      "Get-Lexicon-URL",
                      "Find-Duplicate-Groups",
                      "Get-Custom-Property",
                      "Get-Lookup-Table",
                      "List-Cohorts",
                      "Get-Cohort",
                      "Describe-Cohort-Schema",
                      "List-Metrics",
                      "Get-Metric",
                      "List-Experiments",
                      "Get-Experiment",
                      "Search-Prior-Experiments",
                      "Get-Experiment-Setup-Guidance",
                      "Get-Experiment-Results-Interpretation-Guidance",
                      "Explain-Experiment-Health-Check",
                      "Run-Experiment-Pre-Launch-Checks",
                      "List-Feature-Flags",
                      "Get-Feature-Flag",
                      "Get-Feature-Flag-Setup-Guidance",
                      "Get-Feature-Flag-Lifecycle-Guidance"
                    ]
                  }
                },
                "required": [
                  "name"
