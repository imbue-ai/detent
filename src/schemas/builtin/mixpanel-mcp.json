{
  "mixpanel-mcp-api": {
    "$comment": "Identifies requests to the Mixpanel hosted MCP server (mcp.mixpanel.com, plus the EU and India hosts mcp-eu.mixpanel.com and mcp-in.mixpanel.com).",
    "properties": {
      "domain": {
        "enum": [
          "mcp.mixpanel.com",
          "mcp-eu.mixpanel.com",
          "mcp-in.mixpanel.com"
        ]
      }
    },
    "required": [
      "domain"
    ]
  },
  "mixpanel-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Mixpanel content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "mixpanel-mcp-read-all": {
    "$comment": "Run any read-only Mixpanel MCP tool: run and display Insights/Funnels/Flows/Retention queries, read saved reports, dashboards, metrics, cohorts, experiments, feature flags, Lexicon event and property definitions, data-quality issues, business context, projects, organizations, session replays and the audit log. Includes the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
