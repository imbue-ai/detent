{
  "coda-mcp-api": {
    "$comment": "Identifies requests to the Coda (Superhuman Docs) hosted MCP server (coda.io, docs.superhuman.com).",
    "properties": {
      "domain": {
        "enum": [
          "coda.io",
          "docs.superhuman.com"
        ]
      }
    },
    "required": [
      "domain"
    ]
  },
  "coda-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Coda content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/apis/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "coda-mcp-read-all": {
    "$comment": "View anything in Coda without changing it: search docs, pages, tables and people, read page content, comments and table rows, inspect document structure, evaluate formulas, and see the signed-in account and its notifications. Includes the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/apis/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "search",
                      "name_match",
                      "url_convert",
                      "whoami",
                      "tool_guide",
                      "notifications_list",
                      "document_outline",
                      "schema_explain",
                      "page_describe",
                      "content_read",
                      "page_read",
                      "control_read",
                      "table_rows_read",
                      "table_columns_read",
                      "formula_execute"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
