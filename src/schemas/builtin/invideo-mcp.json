{
  "invideo-mcp-api": {
    "$comment": "Identifies requests to the invideo hosted MCP server (mcp.invideo.io).",
    "properties": {
      "domain": {
        "const": "mcp.invideo.io"
      }
    },
    "required": [
      "domain"
    ]
  },
  "invideo-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify invideo content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "invideo-mcp-read-all": {
    "$comment": "Look at video projects without changing anything: list projects, read timelines, media and exports, and ask the server for help on how projects, timelines and media work, plus the MCP session handshake. invideo does not publicly document its MCP tool catalog, so this permission is based on tool-name conventions (tools whose names start with a read-style verb such as get, list or show).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count|inspect|catalog|probe)([_-]|[A-Z]|$)"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "invideo-mcp-write-all": {
    "$comment": "Create and edit video projects: bring in media, change timelines, branch and checkpoint edits, generate images, video and audio (which spends invideo credits), and export finished videos, plus the MCP session handshake. invideo does not publicly document its MCP tool catalog, so this permission is based on tool-name conventions (any tool whose name does not start with a read-style verb such as get, list or show).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count|inspect|catalog|probe)([_-]|[A-Z]|$)"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
