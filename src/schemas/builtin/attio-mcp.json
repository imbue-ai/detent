            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "list-objects",
                      "search-records",
                      "list-records",
                      "get-records-by-ids",
                      "list-attribute-definitions",
                      "list-activities",
                      "list-activity-attribute-definitions",
                      "list-activity-records",
                      "list-lists",
                      "list-list-attribute-definitions",
                      "list-records-in-list",
                      "list-comments",
                      "list-comment-replies",
                      "search-notes-by-metadata",
                      "semantic-search-notes",
                      "get-note-body",
                      "list-tasks",
                      "search-meetings",
                      "search-call-recordings-by-metadata",
                      "semantic-search-call-recordings",
                      "get-call-recording",
                      "search-emails-by-metadata",
                      "semantic-search-emails",
                      "get-email-content",
                      "list-workspace-members",
                      "list-workspace-teams",
                      "whoami",
                      "run-basic-report",
                      "query-particle-sql"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
