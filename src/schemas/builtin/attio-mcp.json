{
  "attio-mcp-api": {
    "$comment": "Identifies requests to the Attio hosted MCP server (mcp.attio.com).",
    "properties": {
      "domain": {
        "const": "mcp.attio.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "attio-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Attio data.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "attio-mcp-read-all": {
    "$comment": "View anything in the Attio workspace: records, activities, lists, comments, notes, tasks, meetings, call recordings, emails, workspace members, reports and read-only SQL queries, plus the MCP session handshake.",
