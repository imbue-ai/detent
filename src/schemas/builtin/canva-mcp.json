{
  "canva-mcp-api": {
    "$comment": "Identifies requests to the Canva hosted MCP server (mcp.canva.com).",
    "properties": {
      "domain": {
        "const": "mcp.canva.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "canva-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Canva content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "canva-mcp-read-all": {
    "$comment": "View anything in Canva without changing it: search and read designs, export designs, browse assets, folders, comments, brand templates and brand kits, and check the progress of background jobs. Also includes the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "search-designs",
                      "get-design",
                      "get-design-pages",
                      "get-design-content",
                      "get-presenter-notes",
                      "get-design-thumbnail",
                      "get-create-design-async-job",
                      "resolve-shortlink",
                      "get-export-formats",
                      "export-design",
                      "get-assets",
                      "get-generate-image-job",
                      "get-separate-image-layers-job",
                      "list-folder-items",
                      "search-folders",
                      "list-comments",
                      "list-replies",
                      "search-brand-templates",
                      "list-brand-kits",
                      "get-brand-template-dataset",
                      "get-design-dataset",
                      "help"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "canva-mcp-write-all": {
