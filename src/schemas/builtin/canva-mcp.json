                      "upload-asset-from-url",
                      "create-upload-url",
                      "generate-image",
                      "remove-background",
                      "separate-image-layers",
                      "create-folder",
                      "move-item-to-folder",
                      "comment-on-design",
                      "reply-to-comment",
