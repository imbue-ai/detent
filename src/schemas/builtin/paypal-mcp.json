{
  "paypal-mcp-api": {
    "$comment": "Identifies requests to the PayPal hosted MCP server (mcp.paypal.com, or mcp.sandbox.paypal.com for the sandbox).",
    "properties": {
      "domain": {
        "enum": [
          "mcp.paypal.com",
          "mcp.sandbox.paypal.com"
        ]
      }
    },
    "required": [
      "domain"
    ]
  },
  "paypal-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify PayPal data.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "paypal-mcp-read-all": {
    "$comment": "Run any read-only PayPal MCP tool (view invoices, products, subscriptions, orders, refunds, disputes, shipment tracking, transactions and sales insights) plus the MCP session handshake. Never moves money or changes anything.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "list_invoices",
                      "get_invoice",
                      "search_invoicing",
                      "get_recurring_series",
                      "generate_invoice_qr_code",
                      "generate_invoice_number",
                      "list_products",
                      "list_product",
                      "show_product_details",
                      "search_product",
                      "list_subscription_plans",
                      "show_subscription_plan_details",
                      "show_subscription_details",
                      "get_order",
                      "get_order_details",
                      "get_refund",
                      "list_disputes",
                      "get_dispute",
                      "get_shipment_tracking",
                      "list_transactions",
                      "list_transaction",
                      "get_merchant_insights"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
