{
  "trello-mcp-api": {
    "$comment": "Identifies requests to the Trello hosted MCP server (mcp.trello.com).",
    "properties": {
      "domain": {
        "const": "mcp.trello.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "trello-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Trello content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/v1/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "trello-mcp-read-all": {
    "$comment": "View anything in Trello: your profile, workspaces, boards, lists, cards, checklists, comments, Inbox cards and Planner events, and search across boards and cards. Nothing is created or changed.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/v1/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "trelloReadMember",
                      "trelloReadWorkspace",
                      "trelloReadBoard",
                      "trelloReadList",
                      "trelloReadCard",
                      "trelloReadChecklist",
                      "trelloSearch",
                      "trelloReadInbox",
                      "trelloReadPlanner"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
