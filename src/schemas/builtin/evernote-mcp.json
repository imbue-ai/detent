          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "create_note",
                      "edit_note",
                      "update_note_tags",
                      "move_notes",
                      "restore_note",
                      "start_attachment_upload",
                      "finalize_attachment",
                      "delete_note",
                      "create_notebook",
                      "rename_notebook",
                      "move_notebook",
                      "create_space",
                      "create_tag",
                      "edit_tag",
                      "create_task",
                      "update_task",
                      "delete_task"
