{
  "evernote-mcp-api": {
    "$comment": "Identifies requests to the Evernote hosted MCP server (mcp.evernote.com).",
    "properties": {
      "domain": {
        "const": "mcp.evernote.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "evernote-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Evernote content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "evernote-mcp-read-all": {
    "$comment": "Look up anything in Evernote without changing it: search and read notes, download attachments, and list notebooks, Spaces, tags and tasks. Also allows the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "search_notes",
                      "semantic_search",
                      "get_note",
                      "get_attachment",
                      "search_notebooks",
                      "search_spaces",
                      "get_space",
                      "search_tags",
                      "search_tasks",
                      "get_task"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "evernote-mcp-write-all": {
    "$comment": "Make any change in Evernote: create, edit, tag, move, trash and restore notes, upload attachments, manage notebooks, Spaces and tags, and create, update or delete tasks. Also allows the MCP session handshake.",
