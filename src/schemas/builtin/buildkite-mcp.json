{
  "buildkite-mcp-api": {
    "$comment": "Identifies requests to the Buildkite hosted MCP server (mcp.buildkite.com).",
    "properties": {
      "domain": {
        "const": "mcp.buildkite.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "buildkite-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Buildkite data.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp(/readonly|/x/[a-z_]+(/readonly)?)?/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "buildkite-mcp-read-all": {
    "$comment": "Run any read-only Buildkite MCP tool (account and token info, clusters, queues, secret metadata, cache registries, agents, pipelines, schedules, builds, jobs, logs, artifacts, annotations, Test Engine data, failure summaries, skill guides) plus the MCP session handshake. Also covers the read-only and single-toolset endpoint variants (/mcp/readonly, /mcp/x/<toolset>).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp(/readonly|/x/[a-z_]+(/readonly)?)?/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "current_user",
                      "user_token_organization",
                      "access_token",
                      "list_clusters",
                      "get_cluster",
                      "list_cluster_queues",
                      "get_cluster_queue",
                      "list_cluster_secrets",
                      "get_cluster_secret",
                      "list_cache_registries",
                      "get_cache_registry",
                      "list_agents",
                      "get_agent",
                      "list_pipelines",
                      "get_pipeline",
                      "validate_pipeline",
                      "get_pipeline_github_webhook_processing",
                      "list_pipeline_schedules",
                      "get_pipeline_schedule",
                      "list_repository_connections",
                      "get_repository_connection",
                      "list_builds",
                      "get_build",
                      "get_build_test_engine_runs",
                      "wait_for_build",
                      "list_step_uploads",
                      "get_step_upload",
                      "list_jobs",
                      "get_job",
                      "get_job_env",
                      "get_build_failure_summary",
                      "compare_builds",
                      "list_annotations",
                      "search_logs",
                      "tail_logs",
                      "read_logs",
                      "list_artifacts_for_build",
                      "list_artifacts_for_job",
                      "get_artifact",
                      "list_tests",
                      "list_tests_for_build",
                      "get_test",
                      "list_test_runs",
                      "get_test_run",
                      "get_failed_executions",
                      "slowest_executions_for_build",
                      "read_execution_trace",
                      "list_test_suites_for_pipeline",
                      "list_test_workflows",
                      "get_test_workflow",
                      "list_skills",
                      "load_skill"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "buildkite-mcp-write-all": {
