                      "delete_trigger",
                      "create_storage_bucket",
                      "delete_storage_bucket",
                      "delete_storage_object",
                      "delete_storage_objects_by_prefix",
                      "presign_storage_object",
                      "enable_realtime",
                      "disable_realtime",
                      "get_realtime_secret",
                      "rotate_realtime_secret",
                      "send_feedback"
