            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "canvas_read_as_svg",
                      "canvas_search",
                      "canvas_get_canvas_composer_skill",
                      "canvas_load_format_skill",
                      "board_search_boards",
                      "board_show",
                      "board_get_space",
                      "content_item_list_roles",
                      "space_list",
                      "space_list_boards",
                      "space_list_children",
                      "blog_post_list",
                      "table_list_rows",
                      "table_get_latest_update_history",
                      "comment_list_comments",
                      "image_get_data",
                      "image_get_url",
                      "prototype_read",
                      "user_who_am_i",
                      "user_search_organization_users",
                      "get_brand_context"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
