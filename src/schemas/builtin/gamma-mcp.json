{
  "gamma-mcp-api": {
    "$comment": "Identifies requests to the Gamma hosted MCP server (mcp.gamma.app).",
    "properties": {
      "domain": {
        "const": "mcp.gamma.app"
      }
    },
    "required": [
      "domain"
    ]
  },
  "gamma-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Gamma content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "gamma-mcp-read-all": {
    "$comment": "Browse, search and read existing gammas, templates, themes, folders, comments and engagement analytics, export gammas to PDF, PPTX or PNG, and check the progress of generation, edit and export jobs. Does not create or change anything.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "get_generation_status",
                      "get_image_generation_status",
                      "export_gamma",
                      "get_export_status",
                      "get_edit_status",
                      "get_gammas",
                      "search_gammas",
                      "search_templates",
                      "read_gamma",
                      "get_gamma_outline",
                      "get_gamma_comments",
                      "get_gamma_analytics",
                      "get_gamma_card_analytics",
                      "get_gamma_viewer_analytics",
                      "get_gamma_viewer_detail_analytics",
                      "get_themes",
                      "get_folders",
                      "mention_gammas"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
