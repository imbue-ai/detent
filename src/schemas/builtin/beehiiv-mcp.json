{
  "beehiiv-mcp-api": {
    "$comment": "Identifies requests to the beehiiv hosted MCP server (mcp.beehiiv.com).",
    "properties": {
      "domain": {
        "const": "mcp.beehiiv.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "beehiiv-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify beehiiv content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "beehiiv-mcp-read-all": {
    "$comment": "Look up newsletter data without changing anything: publications, posts and their content and stats, subscribers, segments, automations, podcasts, website analytics and monetization data, plus the MCP session handshake. beehiiv does not publicly document its MCP tool catalog, so this permission is based on tool-name conventions (tools whose names start with a read-style verb such as get or list).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count)([_-]|[A-Z]|$)"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "beehiiv-mcp-write-all": {
    "$comment": "Create, edit or manage newsletter data: post drafts and templates, subscriber tags and custom fields, segments, surveys and polls, signup forms, automations, products and tiers, website metadata and redirects, assets, plus the MCP session handshake. beehiiv does not publicly document its MCP tool catalog, so this permission is based on tool-name conventions (any tool whose name does not start with a read-style verb such as get or list).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count)([_-]|[A-Z]|$)"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
