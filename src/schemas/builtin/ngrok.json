{
  "ngrok-api": {
    "$comment": "All requests to the ngrok API.",
    "properties": {
      "domain": {
        "const": "api.ngrok.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "ngrok-read-all": {
    "$comment": "Read anything from the ngrok API. Every ngrok read is a GET (list/get); no GET mutates state.",
    "properties": {
      "method": {
        "const": "GET"
      }
    },
    "required": [
      "method"
    ]
  },
  "ngrok-write-all": {
    "$comment": "Create, update, delete, or run actions (e.g. restart/stop a tunnel session) through the ngrok API.",
    "properties": {
      "method": {
        "enum": [
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ]
      }
    },
    "required": [
      "method"
    ]
  },
  "ngrok-read-credentials": {
    "$comment": "List and inspect tunnel credentials (the ngrok agent authtokens used to bring up tunnels).",
    "properties": {
      "method": {
        "const": "GET"
      },
      "path": {
        "type": "string",
        "pattern": "^/credentials(/.*)?$"
      }
    },
    "required": [
      "method",
      "path"
    ]
  },
  "ngrok-write-credentials": {
    "$comment": "Mint, update, or delete tunnel credentials (create the ngrok agent authtokens used to bring up tunnels).",
    "properties": {
      "method": {
        "enum": [
          "POST",
          "PATCH",
          "DELETE"
        ]
      },
      "path": {
        "type": "string",
        "pattern": "^/credentials(/.*)?$"
      }
    },
    "required": [
      "method",
      "path"
    ]
  },
  "ngrok-read-api-keys": {
    "$comment": "List and inspect API keys.",
    "properties": {
      "method": {
        "const": "GET"
      },
      "path": {
        "type": "string",
        "pattern": "^/api_keys(/.*)?$"
      }
    },
    "required": [
      "method",
      "path"
    ]
  },
  "ngrok-write-api-keys": {
    "$comment": "Create, update, or delete API keys.",
    "properties": {
      "method": {
        "enum": [
          "POST",
          "PATCH",
          "DELETE"
        ]
      },
      "path": {
        "type": "string",
        "pattern": "^/api_keys(/.*)?$"
      }
    },
    "required": [
      "method",
      "path"
    ]
  }
}
