{
  "ngrok-api": {
    "$comment": "All requests to the ngrok API.",
    "properties": {
      "domain": {
        "const": "api.ngrok.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "ngrok-read-all": {
    "$comment": "Read anything from the ngrok API.",
    "properties": {
      "method": {
        "const": "GET"
      }
    },
    "required": [
      "method"
    ]
  },
  "ngrok-write-all": {
    "$comment": "Create, update, or delete anything through the ngrok API.",
    "properties": {
      "method": {
        "enum": [
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ]
      }
    },
    "required": [
      "method"
    ]
  }
}
