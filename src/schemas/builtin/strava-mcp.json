{
  "strava-mcp-api": {
    "$comment": "Identifies requests to the Strava hosted MCP server (mcp.strava.com).",
    "properties": {
      "domain": {
        "const": "mcp.strava.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "strava-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Strava content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-read-all": {
    "$comment": "Run any Strava MCP tool (browse and search the athlete's activities, read per-second activity data such as heart rate, pace, power and GPS, see laps, splits, segment efforts and personal records, view the athlete's profile and training zones, look up clubs and their events, and see bikes and shoes) plus the MCP session handshake. Strava's hosted MCP server is read-only, so this covers every tool it offers; nothing can be uploaded, changed or deleted.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "health",
                      "get_athlete_profile",
                      "get_athlete_zones",
                      "list_activities",
                      "get_activity_streams",
                      "get_activity_performance",
                      "get_club_info",
                      "get_gear"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-read-activities": {
    "$comment": "Browse and search the athlete's activities by date, sport and tags, and read their details: per-second heart rate, pace, power, cadence, altitude and GPS data, plus laps, splits, segment efforts, best efforts and personal records.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "list_activities",
                  "get_activity_streams",
                  "get_activity_performance"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-read-profile": {
    "$comment": "View the athlete's own Strava profile and their heart rate, power and pace training zones.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "get_athlete_profile",
                  "get_athlete_zones"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-read-clubs": {
    "$comment": "Look up information about the athlete's clubs, including their members and events.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "const": "get_club_info"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-read-gear": {
    "$comment": "See the athlete's bikes and shoes and the distance logged on each.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "const": "get_gear"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "strava-mcp-check-health": {
    "$comment": "Check that the Strava MCP server is up and responding. Reveals no athlete data.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "const": "health"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
