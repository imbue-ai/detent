{
  "readwise-mcp-api": {
    "$comment": "Identifies requests to the Readwise hosted MCP server (mcp2.readwise.io).",
    "properties": {
      "domain": {
        "const": "mcp2.readwise.io"
      }
    },
    "required": [
      "domain"
    ]
  },
  "readwise-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Readwise content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "readwise-mcp-read-all": {
    "$comment": "View anything in Readwise without changing it: search and list highlights, the Daily Review, Reader documents and tags, document exports, the Books library, reading sessions and stats, and public feed tokens. Also includes the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "readwise_search_highlights",
                      "readwise_list_highlights",
                      "readwise_get_daily_review",
                      "reader_get_document_highlights",
                      "reader_search_documents",
                      "reader_list_documents",
                      "reader_get_document_details",
                      "reader_list_tags",
                      "reader_export_documents",
                      "reader_get_export_documents_status",
                      "books_list_books",
                      "books_list_sessions",
                      "books_get_sessions_by_day",
                      "books_get_stats_summary",
                      "books_list_public_tokens"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "readwise-mcp-write-all": {
