{
  "supabase-mcp-api": {
    "$comment": "Identifies requests to the Supabase hosted MCP server (mcp.supabase.com).",
    "properties": {
      "domain": {
        "const": "mcp.supabase.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "supabase-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Supabase content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "supabase-mcp-read-all": {
    "$comment": "Run any read-only Supabase MCP tool (inspect database schema and migrations, read logs and advisors, project URLs and API keys, generated types, Edge Function source, organizations and projects, costs, docs search, branches, storage config, notebooks) plus the MCP session handshake. Does not include execute_sql.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "list_tables",
                      "list_extensions",
                      "list_migrations",
                      "get_logs",
                      "query_logs",
                      "get_advisors",
                      "get_project_url",
                      "get_publishable_keys",
                      "get_anon_key",
                      "generate_typescript_types",
                      "list_edge_functions",
                      "get_edge_function",
                      "list_organizations",
                      "get_organization",
                      "list_projects",
                      "get_project",
                      "get_cost",
                      "confirm_cost",
                      "search_docs",
                      "list_branches",
                      "list_storage_buckets",
                      "get_storage_config",
                      "list_notebooks",
                      "get_notebook"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "supabase-mcp-write-all": {
    "$comment": "Run any Supabase MCP tool that changes something: execute SQL, apply migrations, deploy Edge Functions and secrets, create/pause/restore projects, create/merge/rebase/reset/delete branches, update storage config, create and run notebooks, and send feedback, plus the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "execute_sql",
                      "apply_migration",
                      "deploy_edge_function",
                      "create_edge_function_secret",
                      "create_project",
                      "pause_project",
                      "restore_project",
                      "create_branch",
                      "merge_branch",
                      "rebase_branch",
                      "delete_branch",
                      "reset_branch",
                      "update_storage_config",
                      "create_notebook",
                      "run_notebook",
                      "submit_feedback",
                      "delete_feedback"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
