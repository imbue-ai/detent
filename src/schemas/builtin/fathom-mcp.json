{
  "fathom-mcp-api": {
    "$comment": "Identifies requests to the Fathom hosted MCP server (api.fathom.ai, also reachable at fathom.video).",
    "properties": {
      "domain": {
        "enum": [
          "api.fathom.ai",
          "fathom.video"
        ]
      }
    },
    "required": [
      "domain"
    ]
  },
  "fathom-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Fathom content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "fathom-mcp-read-all": {
    "$comment": "Run any Fathom MCP tool (list and search recorded meetings, find the meetings a person took part in, read meeting transcripts and summaries, look up a recording from a link or call ID, see the connected account and its teams) plus the MCP session handshake. Fathom's hosted MCP server is read-only, so this covers every tool it offers; nothing can be created, changed or deleted.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "list_meetings",
                      "search_meetings",
                      "find_person",
                      "get_recording_by_url",
                      "get_recording_by_call_id",
                      "get_meeting_transcript",
                      "get_meeting_summary",
                      "get_identity",
                      "list_teams"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "fathom-mcp-read-meetings": {
    "$comment": "Browse and search recorded meetings: list meetings with filters, search them by keyword, find the meetings a person took part in, and look up a recording from a meeting link or call ID. Does not return transcripts or summaries.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "list_meetings",
                  "search_meetings",
                  "find_person",
                  "get_recording_by_url",
                  "get_recording_by_call_id"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "fathom-mcp-read-transcripts": {
    "$comment": "Read the full transcript of a recorded meeting, including who said what and when.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "const": "get_meeting_transcript"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "fathom-mcp-read-summaries": {
    "$comment": "Read the AI-generated summary of a recorded meeting.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "const": "get_meeting_summary"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "fathom-mcp-read-account": {
    "$comment": "See which Fathom account is connected (name and email) and which teams it belongs to.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "get_identity",
                  "list_teams"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
