            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "create_personal_tasks",
                      "update_task_preview",
                      "apply_bulk_task_updates",
                      "create_subtasks",
                      "update_subtask",
                      "create_lists",
                      "set_reminder",
                      "set_recurring_reminder",
                      "create_workspace_tasks",
                      "create_board",
                      "create_calendar_events",
                      "update_calendar_events_preview",
                      "apply_bulk_event_updates",
                      "delete_calendar_events_preview"
