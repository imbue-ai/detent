{
  "netlify-mcp-api": {
    "$comment": "Identifies requests to the Netlify hosted MCP server (netlify-mcp.netlify.app, also served as mcp.netlify.com).",
    "properties": {
      "domain": {
        "enum": [
          "netlify-mcp.netlify.app",
          "mcp.netlify.com"
        ]
      }
    },
    "required": [
      "domain"
    ]
  },
  "netlify-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Netlify content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "netlify-mcp-read-all": {
    "$comment": "Run any read-only Netlify MCP tool (coding guidance, user and team info, projects and forms, deploys, extensions, database setup steps, observability queries and request logs, design-import status) on either tool surface (the netlify-*-services-reader selectors or the per-operation netlify-<domain>-<operation> tools), plus the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "get-netlify-coding-context",
                      "netlify-coding-rules",
                      "netlify-user-services-reader",
                      "netlify-team-services-reader",
                      "netlify-user-get-user",
                      "netlify-team-get-teams",
                      "netlify-team-get-team",
                      "netlify-team-get-team-env-vars",
                      "netlify-project-services-reader",
                      "netlify-project-get-project",
                      "netlify-project-get-projects",
                      "netlify-project-get-forms-for-project",
                      "netlify-deploy-services-reader",
                      "netlify-deploy-get-deploy",
                      "netlify-deploy-get-deploy-for-site",
                      "netlify-extension-services-reader",
                      "netlify-extension-get-extensions",
                      "netlify-extension-get-full-extension-details",
                      "netlify-get-database-setup-steps",
                      "netlify-observability-services-reader",
                      "netlify-observability-get-counts",
                      "netlify-observability-get-topk",
                      "netlify-observability-get-timeseries",
                      "netlify-observability-get-request-logs",
                      "netlify-observability-get-request-detail",
                      "get-design-import-job-status"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
