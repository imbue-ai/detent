{
  "notion-mcp-api": {
    "$comment": "Any request to Notion's hosted MCP endpoint (mcp.notion.com).",
    "properties": {
      "domain": {
        "const": "mcp.notion.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "notion-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Notion content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "notion-mcp-read-all": {
    "$comment": "Run any read-only Notion MCP tool (search, fetch, queries, page lists, skills, attachments, comments, teams, users, agent sessions) plus the MCP session handshake.",
