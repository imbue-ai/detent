{
  "ticktick-mcp-api": {
    "$comment": "Identifies requests to the TickTick hosted MCP server (mcp.ticktick.com).",
    "properties": {
      "domain": {
        "const": "mcp.ticktick.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "ticktick-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify TickTick content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "ticktick-mcp-read-all": {
    "$comment": "Run any read-only TickTick MCP tool (search and list tasks, lists, folders, sections, tags, comments, members, habits and check-ins, focus records, connected calendars, countdowns) plus the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "search_task",
                      "get_task_by_id",
                      "list_undone_tasks_by_time_query",
                      "list_undone_tasks_by_date",
                      "list_completed_tasks_by_date",
                      "filter_tasks",
                      "get_task_in_project",
                      "get_comment",
                      "list_projects",
                      "get_project_by_id",
                      "get_project_with_undone_tasks",
                      "list_columns",
                      "list_project_groups",
                      "list_project_members",
                      "list_tags",
                      "list_habits",
                      "list_habit_sections",
                      "get_habit",
                      "get_habit_checkins",
                      "get_focuses_by_time",
                      "get_focus",
                      "list_calendar_accounts",
                      "query_calendar_events",
                      "list_countdowns"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
