{
  "indeed-mcp-api": {
    "$comment": "Identifies requests to the Indeed hosted MCP server (mcp.indeed.com).",
    "properties": {
      "domain": {
        "const": "mcp.indeed.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "indeed-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Indeed content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/claude/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "indeed-mcp-read-all": {
    "$comment": "Look up Indeed data without changing anything: search job postings, read full job details, read the account holder's own resume and profile, and research companies (satisfaction, pay, culture, reviews), plus the MCP session handshake. Indeed documents its MCP tools only by display name (Job Search, Job Detail, Get Resume, Get Company Data) and confirms identifiers only for the job tools, so this permission is based on tool-name conventions (tools whose names start with a read-style verb such as get or search).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/claude/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count)([_-]|[A-Z]|$)"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "indeed-mcp-write-all": {
    "$comment": "Run any Indeed tool that could create or change something, plus the MCP session handshake. Indeed currently documents only read-only tools (job search, job details, resume, company data), so this is a safety net for future tools; because the tool catalog is only partially documented, it is based on tool-name conventions (any tool whose name does not start with a read-style verb such as get or search).",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/claude/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "pattern": "^(get|list|search|find|fetch|read|query|describe|lookup|view|retrieve|show|check|count)([_-]|[A-Z]|$)"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "indeed-mcp-read-jobs": {
    "$comment": "Search Indeed job postings and view the full details of a posting (description, requirements, salary, benefits, how to apply). Does not include the account holder's resume or company research.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/claude/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "search_jobs",
                  "get_job_details"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
