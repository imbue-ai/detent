          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "create_profile",
                      "update_account_profile",
                      "add_link",
                      "create_collection",
                      "add_links_to_collection",
                      "update_link",
                      "reorder_link",
                      "upsert_social_link",
                      "reorder_social_links",
                      "delete_link",
                      "delete_social_link",
                      "update_appearance",
                      "submit_recommendation_feedback",
                      "send_message"
                    ]
                  }
                },
                "required": [
                  "name"
