                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
