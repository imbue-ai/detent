{
  "linktree-mcp-api": {
    "$comment": "Identifies requests to the Linktree hosted MCP server (mcp.linktr.ee).",
    "properties": {
      "domain": {
        "const": "mcp.linktr.ee"
      }
    },
    "required": [
      "domain"
    ]
  },
  "linktree-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Linktree content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "linktree-mcp-read-all": {
    "$comment": "View everything on a Linktree account without changing it: profiles, links, social icons, appearance, analytics, recommendations, workspaces and the messages inbox.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "get_profile_sharing_guidance",
                      "list_accessible_profiles",
                      "set_active_profile",
                      "get_account",
                      "get_suggested_bio",
                      "get_social_integrations",
                      "get_knowledge_base",
                      "get_links",
                      "get_social_links",
                      "get_appearance",
                      "get_account_analytics",
                      "get_analytics_lifetime_totals",
                      "get_top_links",
                      "get_profile_views",
                      "get_link_analytics",
                      "get_workspace_profiles_analytics",
                      "pull_recommendations",
                      "get_workspaces_for_user",
                      "get_workspace",
                      "get_workspace_profiles",
                      "get_workspace_members",
                      "get_conversations",
                      "get_messages"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "linktree-mcp-write-all": {
    "$comment": "Make any change to a Linktree account: create and edit profiles, add, edit, reorder and delete links and social icons, change the appearance, record recommendation feedback and send replies to followers.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
