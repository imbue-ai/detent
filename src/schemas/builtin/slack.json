      "path": {
        "type": "string",
        "pattern": "^/api/(conversations\\.(acceptSharedInvite|approveSharedInvite|archive|canvasCreate|canvases\\.create|close|create|declineSharedInvite|externalInvitePermissions\\.set|invite|inviteShared|join|kick|leave|mark|open|rename|requestSharedInvite\\.(approve|deny)|setPurpose|setTopic|unarchive)|subscriptions\\.thread\\.(add|mark|remove))$"
      }
    },
    "required": ["domain", "path"]
  },
