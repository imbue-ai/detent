  },
  "slack-conversations-write": {
    "$comment": "Create, archive, rename, and manage conversations, including membership, topics, read markers, and followed threads.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
