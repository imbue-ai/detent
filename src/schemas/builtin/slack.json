{
  "slack-api": {
    "$comment": "Any interaction with Slack, including file downloads.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)*slack\\.com$"
      }
    },
    "required": ["domain"]
  },
  "slack-read-all": {
    "$comment": "All read operations across Slack: messages, conversations, users, files, reactions, search, pins, bookmarks, and the Later view.",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
          },
          "path": {
            "type": "string",
            "pattern": "^/api/(auth\\.(test|teams\\.list)|api\\.test|team\\.(info|profile\\.get)|bots\\.info|chat\\.(getPermalink|scheduledMessages\\.list)|drafts\\.list|conversations\\.(genericInfo|history|info|list|listConnectInvites|listPrefs|members|replies|requestSharedInvite\\.list|view)|client\\.[A-Za-z0-9.]+|threads\\.getView|subscriptions\\.thread\\.(get|getView)|users\\.(channelSections\\.list|conversations|counts|discoverableContacts\\.lookup|getPresence|identity|info|list|lookupByEmail|prefs\\.get|priority\\.list|profile\\.get)|usergroups\\.(list|users\\.list)|dnd\\.(info|teamInfo)|files\\.(info|list|remote\\.(info|list))|canvases\\.sections\\.lookup|reactions\\.(get|list)|emoji\\.list|search\\.[A-Za-z0-9.]+|pins\\.list|bookmarks\\.list|reminders\\.(info|list)|saved\\.list|stars\\.list)$"
          }
        },
        "required": ["domain", "path"]
      },
      {
        "type": "object",
        "properties": {
          "domain": {
            "const": "edgeapi.slack.com"
          },
          "path": {
            "type": "string",
            "pattern": "^/cache/[^/]+/(permissions/info|channels/(info|membership|search)|huddles/info|users/(counts|info|list|search)|emojis/info)$"
          }
        },
        "required": ["domain", "path"]
      },
      {
        "type": "object",
        "properties": {
          "domain": {
            "const": "files.slack.com"
          },
          "path": {
            "type": "string",
            "pattern": "^/files-(pri|tmb)/[^/]+/(download/)?[^/]+$"
          }
        },
        "required": ["domain", "path"]
      }
    ]
  },
  "slack-write-all": {
    "$comment": "All write operations across Slack: sending messages, managing conversations, updating profiles, uploading files, and modifying reactions, pins, bookmarks, and the Later view. Does not include deleting channels or inviting and deactivating users.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
      },
      "path": {
        "type": "string",
        "pattern": "^/api/(auth\\.revoke|chat\\.(appendStream|command|delete|deleteScheduledMessage|meMessage|postEphemeral|postMessage|scheduleMessage|startStream|stopStream|unfurl|update)|drafts\\.(create|delete|update)|conversations\\.(acceptSharedInvite|approveSharedInvite|archive|canvasCreate|canvases\\.create|close|create|declineSharedInvite|externalInvitePermissions\\.set|invite|inviteShared|join|kick|leave|mark|open|rename|requestSharedInvite\\.(approve|deny)|setPurpose|setTopic|unarchive)|subscriptions\\.thread\\.(add|mark|remove)|users\\.(deletePhoto|prefs\\.set|profile\\.set|setActive|setPhoto|setPresence)|usergroups\\.(create|disable|enable|update|users\\.update)|dnd\\.(endDnd|endSnooze|setSnooze)|files\\.(comments\\.delete|completeUploadExternal|delete|edit|getUploadURLExternal|remote\\.(add|remove|share|update)|revokePublicURL|share|sharedPublicURL|upload)|canvases\\.(access\\.(delete|set)|create|delete|edit)|reactions\\.(add|remove)|pins\\.(add|remove)|bookmarks\\.(add|edit|remove)|reminders\\.(add|complete|delete)|saved\\.(add|clearCompleted|delete|update)|stars\\.(add|remove))$"
      }
    },
    "required": ["domain", "path"]
  },
  "slack-auth-read": {
    "$comment": "Check authentication status and read basic workspace info.",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
          },
          "path": {
            "type": "string",
            "pattern": "^/api/(auth\\.(test|teams\\.list)|api\\.test|team\\.(info|profile\\.get)|bots\\.info)$"
          }
        },
        "required": ["domain", "path"]
      },
      {
        "type": "object",
        "properties": {
          "domain": {
            "const": "edgeapi.slack.com"
          },
          "path": {
            "type": "string",
            "pattern": "^/cache/[^/]+/(permissions/info)$"
          }
        },
        "required": ["domain", "path"]
      }
    ]
  },
  "slack-auth-write": {
    "$comment": "Revoke authentication tokens.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
      },
      "path": {
        "type": "string",
        "pattern": "^/api/auth\\.revoke$"
      }
    },
    "required": ["domain", "path"]
  },
  "slack-chat-read": {
    "$comment": "Get message permalinks and list scheduled messages and drafts.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
      },
      "path": {
        "type": "string",
        "pattern": "^/api/(chat\\.(getPermalink|scheduledMessages\\.list)|drafts\\.list)$"
      }
    },
    "required": ["domain", "path"]
  },
  "slack-chat-write": {
    "$comment": "Send, update, delete, schedule, and draft messages, and run slash commands.",
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
      },
      "path": {
        "type": "string",
        "pattern": "^/api/(chat\\.(appendStream|command|delete|deleteScheduledMessage|meMessage|postEphemeral|postMessage|scheduleMessage|startStream|stopStream|unfurl|update)|drafts\\.(create|delete|update))$"
      }
    },
    "required": ["domain", "path"]
  },
  "slack-conversations-read": {
    "$comment": "Read conversations: history, details, members, threads, and unread counts.",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^(?!files\\.|edgeapi\\.)([a-z0-9-]+\\.)*slack\\.com$"
          },
          "path": {
            "type": "string",
            "pattern": "^/api/(conversations\\.(genericInfo|history|info|list|listConnectInvites|listPrefs|members|replies|requestSharedInvite\\.list|view)|client\\.[A-Za-z0-9.]+|threads\\.getView|subscriptions\\.thread\\.(get|getView))$"
          }
        },
        "required": ["domain", "path"]
      },
      {
        "type": "object",
        "properties": {
