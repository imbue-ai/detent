        "pattern": "^/api/(users\\.(deletePhoto|prefs\\.set|profile\\.set|setActive|setPhoto|setPresence)|usergroups\\.(create|disable|enable|update|users\\.update)|dnd\\.(endDnd|endSnooze|setSnooze))$"
      }
