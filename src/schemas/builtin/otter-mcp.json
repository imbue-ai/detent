{
  "otter-mcp-api": {
    "$comment": "Identifies requests to the Otter.ai hosted MCP server (mcp.otter.ai).",
    "properties": {
      "domain": {
        "const": "mcp.otter.ai"
      }
    },
    "required": [
      "domain"
    ]
  },
  "otter-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Otter.ai content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "otter-mcp-read-all": {
    "$comment": "Run any Otter.ai MCP tool (search meetings by date, attendee, topic, keyword or title; read a meeting's full transcript, summary, outline and action items; see the connected account) plus the MCP session handshake. Otter's hosted MCP server is read-only, so this covers every tool it offers; nothing can be created, changed or deleted.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "search",
                      "otter_search",
                      "fetch",
                      "otter_fetch",
                      "get_user_info",
                      "otter_get_user_info"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "otter-mcp-search-meetings": {
    "$comment": "Search your Otter meetings by date, attendee, topic, keyword, folder, channel or title and see their summaries, outlines and action items.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "search",
                  "otter_search"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "otter-mcp-read-transcripts": {
    "$comment": "Read the full speaker-attributed transcript of a specific Otter meeting, together with its summary, outline, action items and attendees.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "fetch",
                  "otter_fetch"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "otter-mcp-read-account": {
    "$comment": "See the name and email of the connected Otter account.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "const": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "get_user_info",
                  "otter_get_user_info"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "method",
          "params"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  }
}
