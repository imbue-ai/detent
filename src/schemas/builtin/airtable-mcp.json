{
  "airtable-mcp-api": {
    "$comment": "Identifies requests to the Airtable hosted MCP server (mcp.airtable.com).",
    "properties": {
      "domain": {
        "const": "mcp.airtable.com"
      }
    },
    "required": [
      "domain"
    ]
  },
  "airtable-mcp-session": {
    "$comment": "Open and maintain an MCP session: initialize, list tools/prompts/resources, ping, and send notifications. Required for any MCP client to function; does not read or modify Airtable content.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "initialize",
              "notifications/initialized",
              "notifications/cancelled",
              "ping",
              "tools/list",
              "prompts/list",
              "prompts/get",
              "resources/list",
              "resources/read",
              "resources/templates/list",
              "resources/subscribe",
              "resources/unsubscribe",
              "completion/complete",
              "logging/setLevel"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "airtable-mcp-read-all": {
    "$comment": "Run any read-only Airtable MCP tool (browse workspaces and bases, inspect table and field layouts, list and search records, view interface pages and forms, inspect automations) plus the MCP session handshake.",
    "properties": {
      "method": {
        "const": "POST"
      },
      "path": {
        "type": "string",
        "pattern": "^/mcp/?$"
      },
      "parsedBody": {
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "initialize",
                  "notifications/initialized",
                  "notifications/cancelled",
                  "ping",
                  "tools/list",
                  "prompts/list",
                  "prompts/get",
                  "resources/list",
                  "resources/read",
                  "resources/templates/list",
                  "resources/subscribe",
                  "resources/unsubscribe",
                  "completion/complete",
                  "logging/setLevel"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "const": "tools/call"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "list_workspaces",
                      "list_bases",
                      "search_bases",
                      "list_external_accounts",
                      "list_tables_for_base",
                      "get_table_schema",
                      "list_views_for_table",
                      "list_records_for_table",
                      "search_records",
                      "search_candidate_linked_records",
                      "display_records_for_table",
                      "list_pages_for_base",
                      "list_records_for_page",
                      "get_record_for_page",
                      "describe_page_type",
                      "describe_page_element",
                      "get_form_schema",
                      "list_automations",
                      "get_automation",
                      "get_create_automation_instructions",
                      "fetch_automation_input_data"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "path",
      "parsedBody"
    ]
  },
  "airtable-mcp-write-all": {
